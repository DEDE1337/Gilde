# Beispielwerte. ModCheck liest keine .env-Datei selbst: Setze die Werte als
# Umgebungsvariablen, zum Beispiel im Dienst, der den Server startet.

# Adresse und Port. 127.0.0.1 lässt nur diesen Rechner zu.
HOST=127.0.0.1
PORT=3000

# Ordner für Datenbank und Uploads. Standard ist data/ im Projekt.
# MODCHECK_DATA=/var/lib/modcheck

# Hinter einem HTTPS-Proxy auf 1 setzen: Das Sitzungscookie wird dann als Secure markiert.
MODCHECK_HTTPS=0

# Nur auf 1 setzen, wenn ein eigener Proxy X-Forwarded-For zuverlässig setzt.
MODCHECK_TRUST_PROXY=0

# --- Hosting ohne Dateizugriff (Railway, Docker) -------------------------------
# Ordner mit Datenbank und Uploads; bei Docker ist das ein eingehängtes Volume.
# MODCHECK_DATA=/data
# "proxy" hinter einem einzelnen Hosting-Proxy (Railway), "cloudflare" hinter dem Cloudflare-Tunnel, sonst leer.
# MODCHECK_TRUST_PROXY=proxy
# Legt beim ersten Start den ersten Administrator an (Passwort steht einmalig im Log). Danach löschen.
# MODCHECK_BOOTSTRAP_ADMIN=Kevin
# Statt der Dateien in data/ (Werte werden nur gelesen, wenn die Datei fehlt):
# MODCHECK_DISCORD_WEBHOOKS={"ankuendigungen":"https://discord.com/api/webhooks/...","raids":"..."}
# MODCHECK_DOMAIN=modcheck.de
# Zeilenumbrüche im Impressum als \n schreiben:
# MODCHECK_IMPRESSUM=Name\nStraße 1\n12345 Ort
# MODCHECK_CF_ANALYTICS_TOKEN=
# Bot-Token: neue Registrierungen in #offiziere per ✅ / ❌ entscheiden (siehe docs/RAILWAY.md)
# MODCHECK_DISCORD_BOT_TOKEN=
